@echo off
echo Restarting Vehicle Rental System...

echo Stopping any existing processes on port 8080...
for /f "tokens=5" %%a in ('netstat -ano ^| find ":8080"') do (
    echo Terminating process %%a...
    taskkill /F /PID %%a 2>nul
)

echo Waiting 2 seconds...
timeout /t 2 /nobreak >nul

echo Starting Vehicle Rental System...
cd /d "C:\Users\chamidu\Desktop\new oop\VehicleRentalSystem01"
echo Running on port 8080...
./mvnw spring-boot:run
pause
